# --- Chandra OCR engine ---
OCR_MODE=ollama            # "ollama" (local) | "api" (Datalab hosted: datalab.to)
OCR_MODEL=ahmgam/chandra-ocr-2  # verified community ollama tag for Chandra 2, or "chandra-ocr"
OCR_FALLBACK_MODEL=glm-ocr # automatic local fallback if chandra is not pulled
OCR_TIMEOUT_S=300

# Datalab hosted API (only needed when OCR_MODE=api: https://www.datalab.to)
DATALAB_API_KEY=
DATALAB_API_URL=https://www.datalab.to/api/v1/convert

# --- Grading LLM (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
GRADE_MODEL=qwen2.5:7b      # High-reasoning 7B model (replaces leniency-prone 3B)
GRADE_TIMEOUT_S=300
OLLAMA_KEEP_ALIVE=30m

# --- Guard rails & Image Preprocessing ---
MAX_IMAGE_EDGE=1400        # Optimized downscale: cuts ViT tokens by 65%, eliminates silent crashes
GRAYSCALE_NORMALIZE=1      # Convert to contrast-normalized grayscale to sharpen ink & drop shadow
MAX_UPLOAD_MB=20
MAX_PAGES=20

# --- Observability (optional) ---
SENTRY_DSN=
TRACES_SAMPLE_RATE=0.1
