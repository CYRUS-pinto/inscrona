# --- Chandra OCR engine ---
OCR_MODE=ollama            # "ollama" (local, recommended) | "api" (Datalab hosted)
OCR_MODEL=chandra-ocr      # ollama model tag for Chandra OCR
OCR_TIMEOUT_S=300

# Datalab hosted API (only needed when OCR_MODE=api)
DATALAB_API_KEY=
DATALAB_API_URL=https://www.datalab.to/api/v1/convert

# --- Grading LLM (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
GRADE_MODEL=llama3.2:3b
GRADE_TIMEOUT_S=300

# --- Guard rails ---
MAX_IMAGE_EDGE=2000        # never send >2300px to the OCR model (silent-crash bug)
MAX_UPLOAD_MB=20
MAX_PAGES=20

# --- Observability (optional) ---
SENTRY_DSN=
TRACES_SAMPLE_RATE=0.1
