# --- GLM-OCR engine (0.9B, via Ollama) ---
OCR_MODEL=glm-ocr          # ollama model tag for GLM-OCR
OCR_TIMEOUT_S=300

# Two-pass OCR: weak pages (confidence < PASS2_THRESHOLD) are re-run with the
# high-accuracy prompt and the better reading is kept. Set GLM_TWO_PASS=0 to
# disable for maximum throughput.
GLM_TWO_PASS=1
PASS2_THRESHOLD=0.55

# --- Grading LLM (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
GRADE_MODEL=qwen2.5:7b      # High-reasoning 7B model (replaces leniency-prone 3B)
GRADE_TIMEOUT_S=300
OLLAMA_KEEP_ALIVE=30m

# --- Guard rails & Image Preprocessing ---
MAX_IMAGE_EDGE=1400        # Optimized downscale: cuts ViT tokens by 65%, eliminates silent crashes
GRAYSCALE_NORMALIZE=1      # Convert to contrast-normalized grayscale to sharpen ink & drop shadow
MAX_UPLOAD_MB=20
MAX_PAGES=20

# --- Observability (optional) ---
SENTRY_DSN=
TRACES_SAMPLE_RATE=0.1
