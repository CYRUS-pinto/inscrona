# --- GLM-OCR engine (0.9B, via Ollama) ---
OCR_MODEL=glm-ocr          # ollama model tag for GLM-OCR
OCR_TIMEOUT_S=300

# Two-pass OCR: weak pages (confidence < PASS2_THRESHOLD) are re-run with the
# high-accuracy prompt and the better reading is kept. Set GLM_TWO_PASS=0 to
# disable for maximum throughput.
GLM_TWO_PASS=1
PASS2_THRESHOLD=0.55

# --- Grading LLM (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
GRADE_MODEL=llama3.2:3b
GRADE_TIMEOUT_S=300

# --- Guard rails ---
MAX_IMAGE_EDGE=2000        # never send >2300px to GLM-OCR (silent-crash bug)
MAX_UPLOAD_MB=20
MAX_PAGES=20

# --- Observability (optional) ---
SENTRY_DSN=
TRACES_SAMPLE_RATE=0.1
